#!/bin/bash
# Pi-Link Pro - Official Pi-Apps Uninstaller

# Importeer de Pi-Apps API
source "$(dirname "$(dirname "$0")")/api" || exit 1

status "Removing Pi-Link Pro packages..."
# purge_packages verwijdert alleen pakketten die niet door andere apps nodig zijn
purge_packages || error "Failed to remove packages"

status "Cleaning up desktop entries..."
rm -f $HOME/.local/share/applications/pilink.desktop

status_green "Pi-Link Pro has been successfully uninstalled."
